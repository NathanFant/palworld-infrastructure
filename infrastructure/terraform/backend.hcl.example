# Copy to backend.hcl (gitignored) and fill in real values. Used as:
#   terraform init -backend-config=backend.hcl
#
# Uses Terraform's native `oci` backend (requires Terraform >= 1.12), authenticating
# with the *same* tenancy/user OCID + API key as the oci provider itself (provider.tf)
# — unlike the S3-compatible-endpoint approach this replaced, there's no separate
# Customer Secret Key credential needed for the backend.
#
# namespace and the state bucket itself are produced by applying
# infrastructure/terraform-bootstrap once (see its README.md).

bucket           = "palworld-tfstate"
namespace        = "<namespace, from terraform-bootstrap's output>"
key              = "palworld-infrastructure/terraform.tfstate"
region           = "us-ashburn-1"
tenancy_ocid     = "ocid1.tenancy.oc1..exampleuniqueID"
user_ocid        = "ocid1.user.oc1..exampleuniqueID"
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "~/.oci/oci_api_key.pem"
