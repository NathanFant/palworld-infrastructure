.terraform.lock.hcl.bak
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Node / discord-bot
discord-bot/node_modules/
discord-bot/dist/
discord-bot/build/
npm-debug.log*

# Bot runtime state
discord-bot/data/
*.sqlite
*.sqlite3

