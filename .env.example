# Template for real secrets — copy this to .env.local and fill in actual values there.
# .env.local is gitignored and must never be committed. This file (.env.example) only
# ever holds placeholder values, so it's safe to commit and keep up to date.
#
# See CLAUDE.md for what each component is and how they connect.

# ============================================================================
# Discord bot
# ============================================================================
# Application in the Discord Developer Portal, with the GUILD_VOICE_STATES intent
# enabled, invited to your server. GUILD_MESSAGES is deliberately not needed -- the
# bot only uses slash commands and voice-state updates, never reads message content
# (see discord-bot/src/index.ts).
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Channel/role IDs (enable Developer Mode in Discord, right-click -> Copy ID)
DISCORD_VOICE_CHANNEL_ID=
DISCORD_STATUS_CHANNEL_ID=
DISCORD_ADMIN_ROLE_ID=

# ============================================================================
# Game VM SSH control (bot -> palworld-ctl, forced-command restricted key). The bot
# runs on the same VM as the game server (see
# docs/decisions/005-consolidate-bot-onto-game-vm.md), reached over loopback -- these
# point at 127.0.0.1 in production, not a second host.
# ============================================================================
GAME_VM_HOST=127.0.0.1
GAME_VM_SSH_PORT=22
GAME_VM_SSH_USER=palworld-bot
GAME_VM_SSH_PRIVATE_KEY_PATH=./secrets/palworld-bot-ssh-key

# ============================================================================
# Game VM SSH (admin — real shell, separate from the bot's restricted key above).
# Used by scripts/deploy.sh and scripts/deploy-bot.sh, never by the bot itself.
# ============================================================================
ADMIN_SSH_USER=ubuntu
ADMIN_SSH_PRIVATE_KEY_PATH=./secrets/palworld-admin-key

# ============================================================================
# RCON. Loopback-only (127.0.0.1) -- docker/compose.yml publishes it bound to
# 127.0.0.1 specifically, not 0.0.0.0, since only the co-located Discord bot
# container ever needs to reach it (see docs/decisions/005-consolidate-bot-onto-game-vm.md).
# ============================================================================
RCON_HOST=127.0.0.1
RCON_PORT=25575
# The palworld-server-docker image has no separate RCON credential — RCON auth uses
# PALWORLD_ADMIN_PASSWORD below. This MUST be set to the exact same value, or the
# bot's RCON connection will silently fail authentication.
RCON_PASSWORD=

# ============================================================================
# Palworld dedicated server (consumed by docker/compose.yml)
# ============================================================================
PALWORLD_SERVER_NAME="Palworld Server"
PALWORLD_SERVER_DESCRIPTION=""
PALWORLD_ADMIN_PASSWORD=
PALWORLD_SERVER_PASSWORD=
PALWORLD_PUBLIC_PORT=8211
PALWORLD_MAX_PLAYERS=4

# ============================================================================
# Bot lifecycle management
# ============================================================================
SERVER_RESTART_INTERVAL_HOURS=48
BOT_STATE_FILE_PATH=./data/state.json

# ============================================================================
# Oracle Cloud (OCI) — Terraform provider auth
# ============================================================================
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=./secrets/oci-api-key.pem
OCI_REGION=
OCI_COMPARTMENT_OCID=

# ============================================================================
# Backups (Object Storage, S3-compatible endpoint)
# ============================================================================
OCI_BACKUP_NAMESPACE=
OCI_BACKUP_BUCKET_NAME=palworld-backups
OCI_BACKUP_RETENTION_DAILY=7
OCI_BACKUP_RETENTION_WEEKLY=4
